# Copy to stack.env (not committed) and fill in.
# Not named .env.prod on purpose: Symfony would load it and bake it into the image.
# Private registry holding the images (bin/release.sh pushes there)
REGISTRY=ghcr.io/baptistemeunier
# latest (last git-tagged release), a git tag (pin / roll back), or dev
TAG=latest

FRONT_PORT=3000

# --- API (Symfony)
# openssl rand -hex 32
APP_SECRET=
DEFAULT_URI=https://budget.example.com
# OIDC discovery URL
OAUTH2_CONFIGURATION_URL=
OAUTH2_CLIENT_ID=
GOCARDLESS_BASE_URL=https://bankaccountdata.gocardless.com
GOCARDLESS_CLIENT_ID=
GOCARDLESS_CLIENT_SECRET=
# Web Push (VAPID). Generate once: php -r 'require "vendor/autoload.php"; print_r(Minishlink\WebPush\VAPID::createVapidKeys());'
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:you@example.com or the site URL
VAPID_SUBJECT=

# --- MariaDB
DB_NAME=app
DB_USER=app
# openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Front (Nuxt)
NUXT_PUBLIC_OAUTH_CLIENT_ID=
NUXT_PUBLIC_OAUTH_AUTHORIZE_URL=https://auth.meunier.ovh/oauth/authorize
NUXT_OAUTH_TOKEN_URL=https://auth.meunier.ovh/oauth/access_token
NUXT_OAUTH_CLIENT_SECRET=
# Same value as VAPID_PUBLIC_KEY
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
